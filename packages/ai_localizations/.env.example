# ai_localizations Go 工具环境变量
# 复制为 .env 后填写：cp .env.example .env

# config.yaml 路径（相对 ai_localizations 包根目录或绝对路径）
# .env 放在 Flutter 项目根目录时，指向根目录 config.yaml：
AILOC_CONFIG=../../config.yaml

# AI 配置（必填，按你所用的 OpenAI 兼容服务填写，勿绑定特定厂商）
# 工具请求 {AILOC_BASE_URL}/chat/completions，支持任意兼容 Chat Completions 的 API
AILOC_AI_PROVIDER=
AILOC_API_KEY=
AILOC_BASE_URL=
AILOC_MODEL=
AILOC_TEMPERATURE=

# --- 配置示例（任选其一，复制到上方并删掉本段注释）---
#
# Moonshot / Kimi（国内）
# AILOC_AI_PROVIDER=moonshot
# AILOC_API_KEY=sk-xxx
# AILOC_BASE_URL=https://api.moonshot.cn/v1
# AILOC_MODEL=kimi-k2.6
# AILOC_TEMPERATURE=0.6
#
# OpenAI
# AILOC_AI_PROVIDER=openai
# AILOC_API_KEY=sk-xxx
# AILOC_BASE_URL=https://api.openai.com/v1
# AILOC_MODEL=gpt-4o-mini
# AILOC_TEMPERATURE=0.2
#
# DeepSeek
# AILOC_AI_PROVIDER=deepseek
# AILOC_API_KEY=sk-xxx
# AILOC_BASE_URL=https://api.deepseek.com/v1
# AILOC_MODEL=deepseek-chat
# AILOC_TEMPERATURE=0.2

# 翻译提示词模板（\n 表示换行，运行时根据 locales 动态替换占位符）
# 可用占位符：
#   {primary_locale}   - 主语言代码（config.yaml 的 source_locale）
#   {primary_language} - 同 {primary_locale}
#   {source_locale}    - 当前源语言代码
#   {source_language}  - 同 {source_locale}
#   {target_locale}    - 当前目标语言代码
#   {target_language}  - 同 {target_locale}
#   {all_locales}      - 全部 locales
#   {target_locales}   - 除主语言外的目标 locales
AILOC_TRANSLATION_PROMPT=你是一个专业的Flutter应用国际化翻译助手。\n本项目的源语言（主语言）是 {primary_language}（locale: {primary_locale}）。\n请将给定的 {source_language} 文本翻译成 {target_language}（locale: {target_locale}），适用于移动应用界面。\n要求：\n1. 保持简洁明了，适合APP按钮和界面显示\n2. 使用自然、友好的 {target_language} 表达\n3. 保留占位符如 {name}、{appName} 等\n4. 如果是技术术语，请使用标准翻译\n5. 直接回复翻译结果，不要添加额外说明
